  {"id":"WIR-EQ-085","category":"context_coreference","expected_level":"E2","inputs":[{"language":"ja","text":"それは私のです。"},{"language":"en","text":"That one is mine."},{"language":"zh-Hans","text":"那个是我的。"}],"target_semantics":"BELONG_TO(POSSESSED=deictic,POSSESSOR=ctx:speaker)","notes":"Context resolution is deliberately conservative in v0.1."},
  {"id":"WIR-EQ-086","category":"context_coreference","expected_level":"E2","inputs":[{"language":"ja","text":"彼女が到着した。"},{"language":"en","text":"She arrived."},{"language":"zh-Hans","text":"她到了。"}],"target_semantics":"ARRIVE(AGENT=unresolved_female_person)","notes":"Context resolution is deliberately conservative in v0.1."},
