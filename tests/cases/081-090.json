  {"id":"WIR-EQ-081","category":"context_coreference","expected_level":"unsupported","inputs":[{"language":"ja","text":"太郎は次郎に、彼が勝ったと言った。"},{"language":"en","text":"Taro told Jiro that he won."},{"language":"zh-Hans","text":"太郎告诉次郎，他赢了。"}],"target_semantics":"Ambiguous pronoun: he=Taro or Jiro","notes":"Context resolution is deliberately conservative in v0.1."},
  {"id":"WIR-EQ-082","category":"context_coreference","expected_level":"E1","inputs":[{"language":"ja","text":"私はお腹が空いた。"},{"language":"en","text":"I am hungry."},{"language":"zh-Hans","text":"我饿了。"}],"target_semantics":"HUNGRY(EXPERIENCER=ctx:speaker)","notes":""},
  {"id":"WIR-EQ-083","category":"context_coreference","expected_level":"E2","inputs":[{"language":"ja","text":"ここに来て。"},{"language":"en","text":"Come here."},{"language":"zh-Hans","text":"到这里来。"}],"target_semantics":"COME(AGENT=ctx:addressee,DESTINATION=ctx:here)","notes":"Context resolution is deliberately conservative in v0.1."},
